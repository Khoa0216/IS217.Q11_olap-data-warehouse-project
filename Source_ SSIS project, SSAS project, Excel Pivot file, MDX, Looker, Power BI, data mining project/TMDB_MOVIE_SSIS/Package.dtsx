    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        // 1. Ki?m tra xem c?t 'productioncountries' c� gi� tr? NULL hay kh�ng.
        //    N?u l� NULL, ta s? b? qua d�ng n�y ?? tr�nh g�y l?i.
        if (!Row.productioncountries_IsNull)
