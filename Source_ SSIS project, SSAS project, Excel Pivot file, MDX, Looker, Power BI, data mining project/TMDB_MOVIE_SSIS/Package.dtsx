    <DTS:Executable
      DTS:refId="Package\Create All Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C14FE675-FF22-46C6-8BA9-177329EF5EFB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create All Tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{847366FD-4E41-40D4-A28F-5CCCC1C6B3CF}"
          SQLTask:SqlStatementSource="-- Tạo các bảng DIMENSIONS&#xA;CREATE TABLE DIM_MOVIE (&#xA;    MOVIE_ID INT PRIMARY KEY,&#xA;    TITLE NVARCHAR(MAX) NOT NULL,&#xA;    ADULT BIT NOT NULL&#xA;);&#xA;CREATE TABLE DIM_DATE (&#xA;    DATE_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    FULL_DATE DATE NOT NULL,&#xA;    YEAR INT NOT NULL,&#xA;    MONTH INT NOT NULL,&#xA;    DAY INT NOT NULL,&#xA;    HALF_YEAR INT NOT NULL,&#xA;    QUARTER INT NOT NULL&#xA;);&#xA;CREATE TABLE DIM_GENRE (&#xA;    GENRE_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    GENRE_NAME NVARCHAR(200) NOT NULL&#xA;);&#xA;CREATE TABLE DIM_COUNTRY (&#xA;    COUNTRY_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    COUNTRY_NAME NVARCHAR(200) NOT NULL&#xA;);&#xA;CREATE TABLE DIM_LANGUAGE (&#xA;    LANGUAGE_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    LANGUAGE_NAME NVARCHAR(100) NOT NULL&#xA;);&#xA;CREATE TABLE DIM_COMPANY (&#xA;    COMPANY_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    COMPANY_NAME NVARCHAR(255) NOT NULL&#xA;);&#xA;&#xA;-- Tạo các bảng BRIDGE&#xA;CREATE TABLE BRIDGE_MOVIE_GENRE (&#xA;    MOVIE_ID INT,&#xA;    GENRE_ID INT,&#xA;    PRIMARY KEY (MOVIE_ID, GENRE_ID),&#xA;    FOREIGN KEY (MOVIE_ID) REFERENCES DIM_MOVIE(MOVIE_ID),&#xA;    FOREIGN KEY (GENRE_ID) REFERENCES DIM_GENRE(GENRE_ID)&#xA;);&#xA;CREATE TABLE BRIDGE_MOVIE_COUNTRY (&#xA;    MOVIE_ID INT,&#xA;    COUNTRY_ID INT,&#xA;    PRIMARY KEY (MOVIE_ID, COUNTRY_ID),&#xA;    FOREIGN KEY (MOVIE_ID) REFERENCES DIM_MOVIE(MOVIE_ID),&#xA;    FOREIGN KEY (COUNTRY_ID) REFERENCES DIM_COUNTRY(COUNTRY_ID)&#xA;);&#xA;CREATE TABLE BRIDGE_MOVIE_LANGUAGE (&#xA;    MOVIE_ID INT,&#xA;    LANGUAGE_ID INT,&#xA;    IS_ORIGINAL BIT DEFAULT 0,&#xA;    PRIMARY KEY (MOVIE_ID, LANGUAGE_ID),&#xA;    FOREIGN KEY (MOVIE_ID) REFERENCES DIM_MOVIE(MOVIE_ID),&#xA;    FOREIGN KEY (LANGUAGE_ID) REFERENCES DIM_LANGUAGE(LANGUAGE_ID)&#xA;);&#xA;CREATE TABLE BRIDGE_MOVIE_COMPANY (&#xA;    MOVIE_ID INT,&#xA;    COMPANY_ID INT,&#xA;    PRIMARY KEY (MOVIE_ID, COMPANY_ID),&#xA;    FOREIGN KEY (MOVIE_ID) REFERENCES DIM_MOVIE(MOVIE_ID),&#xA;    FOREIGN KEY (COMPANY_ID) REFERENCES DIM_COMPANY(COMPANY_ID)&#xA;);&#xA;&#xA;-- Tạo bảng FACT&#xA;CREATE TABLE FACT_MOVIE (&#xA;    FACT_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    MOVIE_ID INT,&#xA;    DATE_ID INT,&#xA;    RUNTIME INT,&#xA;    BUDGET BIGINT,&#xA;    REVENUE BIGINT,&#xA;    VOTE_AVERAGE FLOAT,&#xA;    VOTE_COUNT INT,&#xA;    POPULARITY FLOAT,&#xA;    FOREIGN KEY (MOVIE_ID) REFERENCES DIM_MOVIE(MOVIE_ID),&#xA;    FOREIGN KEY (DATE_ID) REFERENCES DIM_DATE(DATE_ID)&#xA;);&#xA;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
