    #endregion

    // --- PH?N KHAI B�O BI?N TO�N C?C ---

    // Bi?n ki?u Dictionary ?? l?u tr? c?p key-value (m� ng�n ng? -> t�n ng�n ng?).
    // V� d?: key="en", value="English".
    // Gi�p tra c?u t�n ng�n ng? t? m� m?t c�ch c?c k? nhanh ch�ng.
    private Dictionary<string, string> codeToName;

    // Bi?n ki?u HashSet ?? l?u tr? c�c t�n ng�n ng? ?� ???c xu?t ra output.
    // HashSet ch? cho ph�p l?u c�c gi� tr? DUY NH?T.
    // M?c ?�ch: ??m b?o m?i t�n ng�n ng? ch? ???c xu?t ra m?t l?n duy nh?t, tr�nh tr�ng l?p.
    private HashSet<string> uniqueLanguages;

    /// <summary>
    /// Ph??ng th?c n�y ch? ch?y M?T L?N DUY NH?T tr??c khi d�ng d? li?u ??u ti�n ???c x? l�.
    /// Th??ng d�ng ?? kh?i t?o t�i nguy�n, ??c file c?u h�nh, ho?c chu?n b? d? li?u.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();

        // Kh?i t?o Dictionary, s? d?ng StringComparer.OrdinalIgnoreCase ?? vi?c so s�nh key (m� ng�n ng?)
        // s? kh�ng ph�n bi?t ch? hoa/th??ng (v� d?: 'en' v� 'EN' l� nh? nhau).
        codeToName = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        // Kh?i t?o HashSet, c?ng kh�ng ph�n bi?t hoa/th??ng khi ki?m tra gi� tr? ?� t?n t?i hay ch?a.
        uniqueLanguages = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        // ???ng d?n ??n file CSV ch?a th�ng tin mapping ng�n ng?.
        string csvPath = @"C:\Users\LENOVO\Downloads\CLEAN_DATASET\languages.csv";

        // Ki?m tra xem file c� t?n t?i kh�ng. N?u kh�ng, n�m ra m?t l?i ?? d?ng package SSIS.
        if (!File.Exists(csvPath))
            throw new Exception($"? Kh�ng t�m th?y file CSV: {csvPath}");

        // B?t ??u ??c file CSV.
        // File.ReadLines: ??c file theo t?ng d�ng, ti?t ki?m b? nh? cho c�c file l?n.
        // .Skip(1): B? qua d�ng ??u ti�n v� ?� l� d�ng ti�u ?? (header).
        foreach (var line in File.ReadLines(csvPath).Skip(1))
        {
            // N?u d�ng l� r?ng ho?c ch? ch?a kho?ng tr?ng th� b? qua.
            if (string.IsNullOrWhiteSpace(line)) continue;

            // T�ch d�ng th�nh c�c ph?n t? d?a tr�n d?u ph?y ','.
            var parts = line.Split(',');

            // ??m b?o d�ng c� �t nh?t 2 c?t (code v� name) ?? tr�nh l?i.
            if (parts.Length >= 2)
            {
                // L?y m� ng�n ng? t? c?t ??u ti�n, c?t kho?ng tr?ng v� chuy?n th�nh ch? th??ng.
                string code = parts[0].Trim().ToLower();

                // L?y t�n ng�n ng? t? c?t th? hai, ch? c?n c?t kho?ng tr?ng.
                string name = parts[1].Trim();

                // N?u m� ng�n ng? n�y ch?a c� trong Dictionary, th� th�m v�o.
                // ?i?u n�y ??m b?o ta ch? l?y c?p gi� tr? ??u ti�n n?u c� m� b? tr�ng trong file CSV.
                if (!codeToName.ContainsKey(code))
