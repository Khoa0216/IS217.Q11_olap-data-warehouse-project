#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
//import namespace ch?a class File
using System.IO;
using System.Linq;
using System.Collections.Generic;
using System.Data.SqlClient;
#endregion

/// <summary>
/// This is the class to which to add your code.  Do not change the name, attributes, or parent
/// of this class.
/// </summary>
[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    #region Help:  Using Integration Services variables and parameters
    /* To use a variable in this script, first ensure that the variable has been added to
     * either the list contained in the ReadOnlyVariables property or the list contained in
     * the ReadWriteVariables property of this script component, according to whether or not your
     * code needs to write into the variable.  To do so, save this script, close this instance of
     * Visual Studio, and update the ReadOnlyVariables and ReadWriteVariables properties in the
     * Script Transformation Editor window.
     * To use a parameter in this script, follow the same steps. Parameters are always read-only.
     *
     * Example of reading from a variable or parameter:
     *  DateTime startTime = Variables.MyStartTime;
     *
     * Example of writing to a variable:
     *  Variables.myStringVariable = "new value";
     */
    #endregion

    #region Help:  Using Integration Services Connnection Managers
    /* Some types of connection managers can be used in this script component.  See the help topic
     * "Working with Connection Managers Programatically" for details.
     *
     * To use a connection manager in this script, first ensure that the connection manager has
     * been added to either the list of connection managers on the Connection Managers page of the
     * script component editor.  To add the connection manager, save this script, close this instance of
     * Visual Studio, and add the Connection Manager to the list.
     *
     * If the component needs to hold a connection open while processing rows, override the
     * AcquireConnections and ReleaseConnections methods.
     * 
     * Example of using an ADO.Net connection manager to acquire a SqlConnection:
     *  object rawConnection = Connections.SalesDB.AcquireConnection(transaction);
     *  SqlConnection salesDBConn = (SqlConnection)rawConnection;
     *
     * Example of using a File connection manager to acquire a file path:
     *  object rawConnection = Connections.Prices_zip.AcquireConnection(transaction);
     *  string filePath = (string)rawConnection;
     *
     * Example of releasing a connection manager:
     *  Connections.SalesDB.ReleaseConnection(rawConnection);
     */
    #endregion

    #region Help:  Firing Integration Services Events
    /* This script component can fire events.
     *
     * Example of firing an error event:
     *  ComponentMetaData.FireError(10, "Process Values", "Bad value", "", 0, out cancel);
     *
     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion


    // Dictionary 1: L?u �nh x? T�N -> ID. D? li?u ???c n?p t? b?ng DIM_LANGUAGE trong database.
    // V� d?: key="English", value=101.
    // Gi�p tra c?u ID c?a m?t ng�n ng? m?t c�ch nhanh ch�ng khi ch? bi?t t�n c?a n�.
    private Dictionary<string, int> languageNameToIdMap;

    // Dictionary 2: L?u �nh x? M� -> T�N. D? li?u ???c n?p t? file CSV.
    // V� d?: key="en", value="English".
    // D�ng ?? chuy?n ??i m� ng�n ng? (vd: 'en', 'fr') th�nh t�n ??y ??.
    private Dictionary<string, string> codeToName;

    /// <summary>
    /// Ph??ng th?c n�y ch? ch?y M?T L?N DUY NH?T tr??c khi x? l� d�ng d? li?u ??u ti�n.
    /// Nhi?m v? ch�nh l� n?p t?t c? d? li?u tham chi?u v�o b? nh? (RAM) ?? t?ng t?c ?? x? l�.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        // Kh?i t?o c�c Dictionaries. StringComparer.OrdinalIgnoreCase gi�p vi?c so s�nh key kh�ng ph�n bi?t ch? hoa/th??ng.
        languageNameToIdMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        codeToName = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        // --- PH?N 1: T?i d? li?u NAME -> ID t? Database ---

        // L?y ??i t??ng k?t n?i database t? Connection Manager c?a SSIS c� t�n "Conn_DIM_LANGUAGE".
        object rawDbConn = Connections.ConnDIMLANGUAGE.AcquireConnection(null);
        SqlConnection sqlConn = (SqlConnection)rawDbConn;
        try
        {
            // C�u l?nh SQL ?? l?y ID v� T�n t? b?ng DIM_LANGUAGE.
            string query = "SELECT LANGUAGE_ID, LANGUAGE_NAME FROM DIM_LANGUAGE";
            // S? d?ng 'using' ?? ??m b?o c�c ??i t??ng SqlCommand v� SqlDataReader ???c gi?i ph�ng ?�ng c�ch.
            using (SqlCommand cmd = new SqlCommand(query, sqlConn))
            using (SqlDataReader reader = cmd.ExecuteReader())
            {
                // ??c t?ng d�ng k?t qu? tr? v? t? c�u l?nh SQL.
                while (reader.Read())
                {
                    // L?y t�n t? c?t th? 2 (index 1) v� ID t? c?t th? 1 (index 0).
                    string name = reader.GetString(1);
                    int id = reader.GetInt32(0);
                    // Th�m v�o Dictionary n?u t�n n�y ch?a t?n t?i.
                    if (!languageNameToIdMap.ContainsKey(name))
                    {
                        languageNameToIdMap.Add(name, id);
                    }
                }
            }
        }
        finally
        {
            // R?t quan tr?ng: Lu�n gi?i ph�ng k?t n?i sau khi s? d?ng xong, d� c� l?i hay kh�ng.
            Connections.ConnDIMLANGUAGE.ReleaseConnection(rawDbConn);
        }

        // --- PH?N 2: T?i d? li?u CODE -> NAME t? file CSV ---
        string csvPath = @"C:\Users\LENOVO\Downloads\CLEAN_DATASET\languages.csv";

        // Ki?m tra xem file c� t?n t?i kh�ng.
        if (!File.Exists(csvPath))
        {
            // N?u kh�ng t�m th?y, ghi m?t th�ng b�o l?i v�o log c?a SSIS v� d?ng package.
            bool cancel = false;
            this.ComponentMetaData.FireError(0, "Script Component", $"Kh�ng t�m th?y file CSV t?i ???ng d?n: {csvPath}", "", 0, out cancel);
            throw new FileNotFoundException($"Kh�ng t�m th?y file CSV t?i ???ng d?n: {csvPath}");
        }

        // ??c file CSV, b? qua d�ng ??u ti�n (ti�u ??).
        foreach (var line in File.ReadLines(csvPath).Skip(1))
        {
            if (string.IsNullOrWhiteSpace(line)) continue; // B? qua d�ng tr?ng.
            var parts = line.Split(','); // T�ch d�ng b?ng d?u ph?y.
            if (parts.Length >= 2) // ??m b?o c� �t nh?t 2 c?t.
            {
                string code = parts[0].Trim(); // M� ng�n ng?.
                string name = parts[1].Trim(); // T�n ng�n ng?.
                                               // Th�m v�o Dictionary n?u m� n�y ch?a t?n t?i.
                if (!codeToName.ContainsKey(code))
                {
                    codeToName.Add(code, name);
                }
            }
        }
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    /// <summary>
    /// Ph??ng th?c n�y ???c th?c thi cho M?I D�NG d? li?u ?i v�o Script Component.
    /// </summary>
    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        // Bi?n ?? l?u ID c?a ng�n ng? g?c, gi�p ki?m tra tr�ng l?p ? ph?n sau.
        int? originalLanguageId = null;

        // --- PH?N 1: X? L� NG�N NG? G?C (original_language) ---
        // C?t n�y ch?a M� ng�n ng? (v� d?: "en").
        if (!Row.originallanguage_IsNull && !string.IsNullOrWhiteSpace(Row.originallanguage))
        {
            string originalLangCode = Row.originallanguage.Trim();
            string originalLangName = null;

            // B??c 1: Tra c?u T�N ??y ?? t? M� ng�n ng? b?ng Dictionary `codeToName`.
            if (codeToName.ContainsKey(originalLangCode))
            {
                originalLangName = codeToName[originalLangCode]; // vd: "en" -> "English"
            }

            // B??c 2: Tra c?u ID t? T�N ??y ?? b?ng Dictionary `languageNameToIdMap`.
            if (originalLangName != null && languageNameToIdMap.ContainsKey(originalLangName))
            {
                // L?y ID v� l?u l?i ?? so s�nh ? ph?n sau.
                originalLanguageId = languageNameToIdMap[originalLangName]; // vd: "English" -> 101

                // T?o m?t d�ng output m?i cho ng�n ng? g?c.
                Output0Buffer.AddRow();
                Output0Buffer.IDMOVIE = Row.MOVIEID;
                Output0Buffer.IDLANGUAGE = originalLanguageId.Value;
                Output0Buffer.ISSORIGINAL = true; // ?�nh d?u ?�y l� ng�n ng? G?C.
            }
        }

        // --- PH?N 2: X? L� C�C NG�N NG? ???C N�I (spoken_languages) ---
        // C?t n�y ch?a m?t chu?i c�c T�N ng�n ng?, c�ch nhau b?i d?u ph?y (v� d?: "English, Fran�ais").
        if (!Row.spokenlanguages_IsNull && !string.IsNullOrWhiteSpace(Row.spokenlanguages))
        {
            string[] spokenLanguages = Row.spokenlanguages.Split(',');
            foreach (string lang in spokenLanguages)
            {
                string cleanName = lang.Trim(); // L�m s?ch t�n ng�n ng?.
                if (string.IsNullOrEmpty(cleanName)) continue;

                // Tra c?u ID tr?c ti?p t? T�N ng�n ng? b?ng Dictionary `languageNameToIdMap`.
                if (languageNameToIdMap.ContainsKey(cleanName))
                {
                    int spokenLangId = languageNameToIdMap[cleanName];

                    // KI?M TRA QUAN TR?NG: N?u ID c?a ng�n ng? ???c n�i n�y TR�NG v?i ID
                    // c?a ng�n ng? g?c ?� x? l� ? tr�n, th� B? QUA ?? kh�ng t?o d�ng tr�ng l?p.
                    if (originalLanguageId.HasValue && spokenLangId == originalLanguageId.Value)
                    {
                        continue;
                    }

                    // N?u l� m?t ng�n ng? m?i (kh�ng ph?i ng�n ng? g?c), t?o m?t d�ng output.
                    Output0Buffer.AddRow();
                    Output0Buffer.IDMOVIE = Row.MOVIEID;
                    Output0Buffer.IDLANGUAGE = spokenLangId;
                    Output0Buffer.ISSORIGINAL = false; // ?�nh d?u ?�y KH�NG ph?i l� ng�n ng? g?c.
                }
            }
        }
    }
}
