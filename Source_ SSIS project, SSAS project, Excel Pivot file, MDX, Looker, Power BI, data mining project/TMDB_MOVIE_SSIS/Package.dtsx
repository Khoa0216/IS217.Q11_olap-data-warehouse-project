            // 2. T�ch chu?i trong c?t 'productioncountries' b?ng k� t? d?u ph?y (',').
            //    K?t qu? l� m?t m?ng c�c chu?i, m?i chu?i l� t�n m?t qu?c gia.
            //    V� d?: "USA, UK" -> ["USA", " UK"]
            string[] country = Row.productioncountries.Split(',');

            // 3. L?p qua t?ng chu?i (t?ng qu?c gia) trong m?ng v?a t?o.
            //    (bi?n 'g' ? ?�y c� th? n�n ??t l� 'c' cho d? hi?u h?n, nh?ng kh�ng ?nh h??ng logic)
            foreach (string g in country)
            {
                // 4. Lo?i b? c�c kho?ng tr?ng th?a ? ??u v� cu?i c?a t�n qu?c gia.
                //    V� d?: " UK" -> "UK"
                string countryName = g.Trim();

                // 5. Ki?m tra ?? ch?c ch?n r?ng t�n qu?c gia kh�ng b? r?ng sau khi x? l�.
                //    ?i?u n�y h?u �ch ?? x? l� c�c tr??ng h?p nh? "USA,,UK".
                if (!string.IsNullOrEmpty(countryName))
                {
                    // 6. T?o m?t d�ng M?I trong b? ??m ??u ra (Output Buffer).
                    Output0Buffer.AddRow();

                    // 7. G�n t�n qu?c gia ?� ???c l�m s?ch v�o c?t COUNTRYNAME c?a d�ng m?i.
                    Output0Buffer.COUNTRYNAME = countryName;
                }
            }
        }
    }
