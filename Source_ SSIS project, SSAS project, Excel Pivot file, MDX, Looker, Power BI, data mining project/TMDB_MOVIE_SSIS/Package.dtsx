    /// <summary>
    /// Ph??ng th?c n�y ???c th?c thi cho M?I D�NG d? li?u ?i v�o Script Component.
    /// </summary>
    /// <param name="Row">??i t??ng ??i di?n cho d�ng d? li?u hi?n t?i.</param>
    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        // --- KH?I 1: X? l� c?t 'original_language' ---

        // Ki?m tra xem c?t c� gi� tr? NULL hay kh�ng.
        if (!Row.originallanguage_IsNull)
        {
            // L?y m� ng�n ng? t? d�ng d? li?u, l�m s?ch (c?t kho?ng tr?ng, chuy?n ch? th??ng).
            string code = Row.originallanguage.Trim().ToLower();

            // Tra c?u m� n�y trong Dictionary ?� n?p ? PreExecute().
            if (codeToName.ContainsKey(code))
            {
                // N?u t�m th?y, l?y ra t�n ng�n ng? t??ng ?ng.
                string name = codeToName[code];

                // Ki?m tra xem t�n ng�n ng? n�y ?� ???c th�m v�o output ch?a (ki?m tra trong HashSet).
                if (!uniqueLanguages.Contains(name))
                {
                    // N?u ch?a c�, th�m n� v�o HashSet ?? ?�nh d?u l� "?� x? l�".
                    uniqueLanguages.Add(name);

                    // T?o m?t d�ng m?i trong output v� g�n t�n ng�n ng? v�o.
                    Output0Buffer.AddRow();
                    Output0Buffer.LANGUAGENAME = name;
                }
            }
        }

        // --- KH?I 2: X? l� c?t 'spoken_languages' ---

        // Ki?m tra xem c?t c� gi� tr? NULL hay kh�ng.
        if (!Row.spokenlanguages_IsNull)
        {
            // T�ch chu?i ch?a nhi?u ng�n ng? (ph�n c�ch b?ng d?u ph?y) th�nh m?t m?ng c�c ng�n ng?.
            string[] langs = Row.spokenlanguages.Split(',');

            // L?p qua t?ng ng�n ng? trong m?ng v?a t�ch.
            foreach (string rawLang in langs)
            {
                // L�m s?ch t�n ng�n ng? (c?t kho?ng tr?ng).
                string name = rawLang.Trim();

                // B? qua n?u t�n ng�n ng? b? r?ng sau khi l�m s?ch.
                if (string.IsNullOrEmpty(name)) continue;

                // B? qua n?u t�n ng�n ng? l� "No Language" (kh�ng ph�n bi?t hoa/th??ng).
                if (string.Equals(name, "No Language", StringComparison.OrdinalIgnoreCase)) continue;

                // T??ng t? nh? tr�n, ki?m tra xem t�n ng�n ng? n�y ?� ???c th�m v�o output ch?a.
                if (!uniqueLanguages.Contains(name))
                {
                    // N?u ch?a, th�m v�o HashSet ?? ?�nh d?u.
                    uniqueLanguages.Add(name);

